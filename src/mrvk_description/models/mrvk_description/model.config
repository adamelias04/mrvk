<?xml version="1.0"?>
<model>
  <name>mrvk_description</name>
  <version>1.0</version>
  <sdf version="1.6">model.sdf</sdf>
  <description>
    MRVK "shoddy" meshes exposed as a Gazebo model so that
    model://mrvk_description/meshes/... URIs (converted from package://)
    resolve. Not spawned directly; the robot is spawned from robot_description.
  </description>
</model>
