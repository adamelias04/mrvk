<?xml version="1.0" ?>
<!--
  Baylands demo world.
  Wrapper okolo standardneho Baylands modelu, ktory naviac obsahuje:
    - oscillating box (rovnaky ako v empty.world) ako dynamicku prekazku
    - tenku transparentnu vrstvu ground_plane s path_trail vizualizaciou
      (pre vykreslenie prejazdenej trajektorie v Gazebe)
  Suradnice oscillating boxu a path_trail su nastavene tak, aby kocka
  krizovala typicku trasu robota v Baylands. Uprav podla potreby v
  pripade ineho startu / waypointov.
-->
<sdf version="1.6">
  <world name="default">

    <scene>
      <ambient>0.95 0.95 0.95 1</ambient>
      <background>0.3 0.3 0.3 1</background>
      <shadows>true</shadows>
    </scene>

    <include>
      <uri>model://sun</uri>
    </include>

    <include>
      <uri>model://baylands</uri>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>37.413534</latitude_deg>
      <longitude_deg>-121.996561</longitude_deg>
      <elevation>1.3</elevation>
    </spherical_coordinates>

    <!--
      Tenky priesvitny ground_plane navrch terenu Baylands - sluzi vyhradne
      ako nosic pre path_trail plugin (kresli prejdenu trajektoriu robota).
      Z je nastavene mierne nad povrchom Baylands aby ciara nebola pod nim.
    -->
    <model name="path_trail_carrier">
      <static>1</static>
      <pose>0 0 0.02 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <transparency>1.0</transparency>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
          <plugin name="path_trail" filename="libpath_trail_visual_plugin.so">
            <robot_name>robot</robot_name>
            <min_distance>0.10</min_distance>
            <line_z>0.05</line_z>
          </plugin>
        </visual>
      </link>
    </model>

    <!--
      Dynamicka prekazka - oscilujuca kocka. Default umiestnenie predpoklada
      ze sa robot pohybuje cez okolie pociatku suradnic; uprav <pose> podla
      konkretnej trasy.
    -->
    <model name="dynamic_cube">
      <static>false</static>
      <pose>5 0 0.5 0 0 0</pose>

      <link name="link">
        <inertial>
          <mass>2.0</mass>
          <inertia>
            <ixx>0.166</ixx>
            <iyy>0.166</iyy>
            <izz>0.166</izz>
            <ixy>0.0</ixy>
            <ixz>0.0</ixz>
            <iyz>0.0</iyz>
          </inertia>
        </inertial>

        <collision name="collision">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <box>
              <size>1 1 1</size>
            </box>
          </geometry>
          <material>
            <ambient>1 0 0 1</ambient>
            <diffuse>1 0 0 1</diffuse>
          </material>
        </visual>
      </link>

      <plugin name="oscillate_box_plugin" filename="liboscillate_box_plugin.so">
        <axis>y</axis>
        <amplitude>3.0</amplitude>
        <frequency>0.05</frequency>
      </plugin>
    </model>

    <physics name="default_physics" default="0" type="ode">
      <gravity>0 0 -9.8066</gravity>
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>

  </world>
</sdf>
