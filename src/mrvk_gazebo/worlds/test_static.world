<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <!-- ===================== Svetlo + fyzika ===================== -->
    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <gravity>0 0 -9.8</gravity>

    <physics type="ode">
      <max_step_size>0.01</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>100</real_time_update_rate>
    </physics>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>

    <!-- ===================== Podlaha ===================== -->
    <model name="ground_plane">
      <static>1</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>100</mu>
                <mu2>50</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>50 50</size>
            </plane>
          </geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Grey</name>
            </script>
          </material>
          <!-- Vizualizacia prejdenej trajektorie. Plugin kompenzuje
               scale ground_plane priamo v kode (world->local frame). -->
          <plugin name="path_trail" filename="libpath_trail_visual_plugin.so">
            <robot_name>robot</robot_name>
            <min_distance>0.05</min_distance>
            <line_z>0.05</line_z>
          </plugin>
        </visual>
      </link>
    </model>

    <!-- ===================== Hraničné steny (15×15 m) ===================== -->
    <model name="wall_north">
      <static>1</static>
      <pose>0 7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>15.0 0.2 1.0</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>15.0 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_south">
      <static>1</static>
      <pose>0 -7.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>15.0 0.2 1.0</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>15.0 0.2 1.0</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_east">
      <static>1</static>
      <pose>7.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 15.0 1.0</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.2 15.0 1.0</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>
    <model name="wall_west">
      <static>1</static>
      <pose>-7.5 0 0.5 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 15.0 1.0</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.2 15.0 1.0</size></box></geometry>
          <material><script><name>Gazebo/Blue</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ===================== Statické prekážky ===================== -->
    <!-- box_3 a box_5 su presunute blizsie k startu robota (3,0) -->

    <model name="box_1">
      <static>1</static>
      <pose>4.0 4.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_2">
      <static>1</static>
      <pose>0.0 4.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.5 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>1.0 0.5 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_3">
      <static>1</static>
      <pose>2.0 -1.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.9 0.9 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.9 0.9 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_4">
      <static>1</static>
      <pose>-3.0 -4.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_5">
      <static>1</static>
      <pose>1.0 2.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.8 0.8 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.8 0.8 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="box_6">
      <static>1</static>
      <pose>2.0 -5.0 0.3 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>1.0 0.6 0.6</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>1.0 0.6 0.6</size></box></geometry>
          <material><script><name>Gazebo/Red</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_1">
      <static>1</static>
      <pose>4.0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.30</radius><length>0.8</length></cylinder></geometry></collision>
        <visual    name="v"><geometry><cylinder><radius>0.30</radius><length>0.8</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_2">
      <static>1</static>
      <pose>0.0 -3.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual    name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_3">
      <static>1</static>
      <pose>-5.0 -1.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.30</radius><length>0.8</length></cylinder></geometry></collision>
        <visual    name="v"><geometry><cylinder><radius>0.30</radius><length>0.8</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_4">
      <static>1</static>
      <pose>-5.0 4.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry></collision>
        <visual    name="v"><geometry><cylinder><radius>0.28</radius><length>0.8</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <model name="pillar_5">
      <static>1</static>
      <pose>-3.0 2.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry></collision>
        <visual    name="v"><geometry><cylinder><radius>0.25</radius><length>0.8</length></cylinder></geometry>
          <material><script><name>Gazebo/Yellow</name></script></material>
        </visual>
      </link>
    </model>

    <!-- Vnútorná stena (topologická voľba trasy) -->
    <model name="inner_wall">
      <static>1</static>
      <pose>-1.0 0.0 0.4 0 0 0</pose>
      <link name="link">
        <collision name="c"><geometry><box><size>0.2 3.0 0.8</size></box></geometry></collision>
        <visual    name="v"><geometry><box><size>0.2 3.0 0.8</size></box></geometry>
          <material><script><name>Gazebo/Green</name></script></material>
        </visual>
      </link>
    </model>

    <!-- ===================== GUI (kamera pohľad) ===================== -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <pose>0 -18 18 0 0.9 1.57</pose>
        <view_controller>orbit</view_controller>
      </camera>
    </gui>

  </world>
</sdf>
