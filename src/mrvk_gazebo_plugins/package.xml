<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypelang="RNG" ?>
<package format="3">
  <name>mrvk_gazebo_plugins</name>
  <version>0.0.0</version>
  <description>Gazebo Classic plugins for MRVK (oscillating box obstacle, path trail visual). ROS2 port.</description>
  <maintainer email="adam.eliasdk@gmail.com">adam</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>gazebo_ros</depend>
  <depend>gazebo_dev</depend>

  <export>
    <build_type>ament_cmake</build_type>
    <gazebo_ros gazebo_plugin_path="${prefix}/lib"/>
  </export>
</package>
